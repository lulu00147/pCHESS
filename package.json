{
  "name": "pchess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:engines": "node tools/build-engines.mjs",
    "build:release": "node tools/build-engines.mjs && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check src vite.config.ts eslint.config.js",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "7zip-bin": "5.2.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7"
  }
}
